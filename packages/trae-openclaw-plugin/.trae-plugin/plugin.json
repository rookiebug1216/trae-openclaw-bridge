{
  "name": "openclaw",
  "version": "0.1.0",
  "description": "连接 OpenClaw：查看 agent 与定时任务、触发任务、接收完成通知、向 agent 发消息",
  "i18n": {
    "display_name": {
      "zh-cn": "OpenClaw",
      "en": "OpenClaw"
    },
    "description": {
      "zh-cn": "Trae IDE 与 OpenClaw Gateway 双向桥接插件",
      "en": "Bi-directional bridge between Trae IDE and OpenClaw Gateway"
    }
  },
  "keywords": ["openclaw", "agent", "cron", "bridge"],
  "mcpServers": {
    "openclaw": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/index.mjs"],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  },
  "skills": "./skills/",
  "interface": {
    "displayName": "OpenClaw",
    "shortDescription": "OpenClaw agent 与定时任务桥接",
    "category": "Developer Tools",
    "capabilities": ["Interactive", "Read", "Write"],
    "defaultPrompt": [
      "openclaw 有哪些 agent？",
      "查看 openclaw main 的定时任务",
      "openclaw 有什么新通知"
    ],
    "brandColor": "#FF6A00",
    "logo": "./assets/icon.svg"
  }
}
